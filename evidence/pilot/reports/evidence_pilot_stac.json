    "geometry": null,
    "properties": {
      "eolab:metadata": {
        "version": 1,
        "title": "ATTO forest carbon exchange during the 2023 Amazon drought",
        "description": "During the extreme 2023 drought, measurements near the Amazon Tall Tower Observatory showed that the local forest remained a net carbon sink over the year. The study associated this local response with reduced ecosystem respiration and sufficient soil moisture, while its wider regional analysis found a different carbon balance. This table provides monthly carbon uptake, respiration and net exchange for 2023, supporting investigation of local drought responses and checks on ecosystem models. The linked 2014–2023 source table provides the historical comparison. These tower measurements describe a local forest footprint and cannot establish the carbon balance of the whole Amazon.",
        "keywords": [],
        "license": "CC0-1.0",
        "attribution": "Botia et al. (2026), supporting datasets deposited in Edmond.",
        "doi": "10.17617/3.OU3KYA",
        "citation": "Botia et al. (2026). Supporting datasets for Carbon cycle response to Amazon drought in 2023. Version 1.0. Edmond. https://doi.org/10.17617/3.OU3KYA",
        "categories": [
          "Nature"
        ],
        "risks": [],
        "statuses": [],
        "study_ids": [
          "doi-10.1029-2025AV001658"
        ],
        "study_time": "Monthly flux totals for January through December 2023; Time is a month-end label.",
        "publications": [
          {
            "id": "doi-10.1029-2025AV001658",
            "title": "Reduced Vegetation Uptake During the Extreme 2023 Drought Turns the Amazon Into a Weak Carbon Source",
            "doi": "10.1029/2025AV001658",
            "citation": null,
            "url": "https://agupubs.onlinelibrary.wiley.com/doi/10.1029/2025AV001658",
            "authors": [],
            "year": 2026,
            "notes": [],
            "annotations": {}
          }
        ],
        "annotations": {
          "limitations": [
            "Underlying half-hourly measurements and quality flags are not included.",
            "The source table's finalLat/finalLon describe air-trajectory endpoints, not the tower location."
          ],
          "processing": "Selected 2023 and six columns; original values and numeric precision preserved.",
          "evidence_type": "Local flux observations interpreted alongside regional models",
          "dataset_role": "2023 monthly tower flux observations"
        }
      },
      "title": "ATTO forest carbon exchange during the 2023 Amazon drought",
